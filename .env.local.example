# Copie ce fichier en .env.local (à la racine du projet) et remplace les valeurs
# par celles de ton projet Supabase : Project Settings → API.
#
# ⚠️ Ne commit JAMAIS le fichier .env.local — il est déjà ignoré par .gitignore.

NEXT_PUBLIC_SUPABASE_URL=colle-ici-ta-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=colle-ici-ta-publishable-key
